# Auto detect text files and perform LF normalization
* text=auto

# Scripts that run on Linux / the TV must keep LF endings (CRLF breaks #!/bin/sh)
*.sh   text eol=lf
*.js   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.md   text eol=lf

# Windows batch file stays CRLF
*.cmd  text eol=crlf

# Binary (never normalize)
*.pdf  binary
